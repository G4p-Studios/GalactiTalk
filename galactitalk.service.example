[Unit]
Description=GalactiTalk multi-server TeamTalk bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/path/to/GalactiTalk
ExecStart=/path/to/GalactiTalk/.venv/bin/python /path/to/GalactiTalk/bot.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# Keep secrets in a mode-0600 file outside the repository if needed:
# EnvironmentFile=%h/.config/galactitalk/environment

[Install]
WantedBy=default.target
